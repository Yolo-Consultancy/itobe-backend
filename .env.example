PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/itobe_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:3000
# Cloudinary (obligatoire pour les images — plus de stockage local /uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Itobe Team
# Playlists YouTube Neno (portail Média → Vidéos). Les IDs publics sont déjà dans le code.
# YOUTUBE_CHANNEL_ID reste optionnel (lien « Voir la chaîne »).
YOUTUBE_CHANNEL_ID=
SEED_EDITION_ADMIN_PASSWORD=
SEED_MEDIA_ADMIN_PASSWORD=
